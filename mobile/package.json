{
  "name": "fuelroute-es-mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "format:check": "prettier --check App.tsx index.ts tests eslint.config.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --watch=false",
    "bundle": "expo export --platform android"
  },
  "dependencies": {
    "expo": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "3.9.9",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
